<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aicc_hacp/db" VERSION="2025011500" COMMENT="XMLDB file for local_aicc_hacp plugin">
  <TABLES>
    <TABLE NAME="local_aicc_hacp_logs" COMMENT="Logs for AICC HACP requests">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="session_id" TYPE="char" LENGTH="36" NOTNULL="false"/>
        <FIELD NAME="command" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="request_body" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="signature_valid" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="remote_ip" TYPE="char" LENGTH="45" NOTNULL="false"/>
        <FIELD NAME="user_agent" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="parsed_data_json" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="result_code" TYPE="int" LENGTH="3" NOTNULL="false"/>
        <FIELD NAME="result_message" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_aicc_hacp_usermap" COMMENT="Manual user mappings for AICC HACP">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
  <FIELD NAME="external_id" TYPE="char" LENGTH="100" NOTNULL="true"/>
  <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
  <FIELD NAME="trusted_origin" TYPE="char" LENGTH="100" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="external_id_uk" TYPE="unique" FIELDS="external_id, trusted_origin"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_aicc_export_sessions" COMMENT="Sessions for AICC export launches">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="session_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="scormid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="scoid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="'active'"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="last_activity_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="student_id" TYPE="char" LENGTH="100" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="session_id_uk" TYPE="unique" FIELDS="session_id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_aicc_hacp_student_state" COMMENT="Student state storage for AICC HACP">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="student_id" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="scormid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="scoid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="state_data" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="lesson_status" TYPE="char" LENGTH="50" NOTNULL="false"/>
        <FIELD NAME="lesson_location" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="score" TYPE="char" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="session_time" TYPE="char" LENGTH="20" NOTNULL="false"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="updated_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="student_scorm_uk" TYPE="unique" FIELDS="student_id, scormid, scoid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>