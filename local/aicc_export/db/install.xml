<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aicc_export/db" VERSION="2025011500" COMMENT="XMLDB file for local_aicc_export plugin">
  <TABLES>
    <TABLE NAME="local_aicc_export_sessions" COMMENT="Remote sessions for AICC export">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="session_id" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="token_nonce" TYPE="char" LENGTH="36" NOTNULL="true"/>
        <FIELD NAME="scormid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="scoid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="au" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="'active'"/>
        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="expires_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="last_activity_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="origin" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="student_id" TYPE="char" LENGTH="100" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="session_id_uk" TYPE="unique" FIELDS="session_id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>