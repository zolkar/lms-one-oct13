<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/hacp_handler/db" VERSION="20240729" COMMENT="XMLDB file for Moodle local/hacp_handler"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="local_hacp_handler_users" COMMENT="Maps remote users to local proxy users">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="remote_user_id" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="local_user_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="course_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="remote_user_course" TYPE="unique" FIELDS="remote_user_id, course_id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_hacp_handler_data" COMMENT="Stores AICC data for each user and course">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="user_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="course_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="aicc_data" TYPE="text" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="user_course" TYPE="unique" FIELDS="user_id, course_id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
